# ---------------------------------------------------------------------------
# AI Processing Engine - example configuration.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All values below are placeholders and none of them is a real credential.
# ---------------------------------------------------------------------------

# runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Provider wiring
# PROVIDER_MODE=mock registers deterministic in-process mock adapters (no network,
# no credentials, no cost). PROVIDER_MODE=live registers the real OpenAI,
# Anthropic and Gemini adapters and requires the matching API key below.
PROVIDER_MODE=mock
ENABLED_PROVIDERS=openai,anthropic,gemini
DEFAULT_PROVIDER=openai

# Default model per provider. Left empty on purpose: model identifiers are
# deployment configuration, never hardcoded in the service. A request that
# omits `model` while this is unset fails with MODEL_REQUIRED.
DEFAULT_MODEL_OPENAI=
DEFAULT_MODEL_ANTHROPIC=
DEFAULT_MODEL_GEMINI=

# Provider credentials (server-side only, never accepted from clients).
# Missing keys in live mode make the service fail at boot rather than mid-request.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Per-provider max output token ceiling. This is DEPLOYMENT CONFIGURATION, not a
# hardcoded model limit; leave empty to use the adapter's conservative default.
MAX_OUTPUT_TOKENS_OPENAI=
MAX_OUTPUT_TOKENS_ANTHROPIC=
MAX_OUTPUT_TOKENS_GEMINI=

# Request handling
REQUEST_TIMEOUT_MS=60000
MAX_BODY_BYTES=1048576

# Client authentication. Format: key-id:secret, comma separated.
# A 64-char hex secret is treated as a pre-computed SHA-256 digest.
AUTH_ENABLED=true
SERVICE_API_KEYS=local-dev-key:placeholder-secret-change-me

# Rate limiting (in-process, per instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Optional live integration tests (`npm run test:live`)
# The normal test suite never runs these. Each probe skips unless both the
# provider key and its *_TEST_MODEL value are set.
# ---------------------------------------------------------------------------
OPENAI_TEST_MODEL=
ANTHROPIC_TEST_MODEL=
GEMINI_TEST_MODEL=

# ---------------------------------------------------------------------------
# Fallback (disabled by default). Fallback never overrides an explicitly
# requested provider; it only runs when a request opts in AND this is enabled.
# ---------------------------------------------------------------------------
FALLBACK_ENABLED=false
# Default order used when a request enables fallback without naming providers.
FALLBACK_PROVIDERS=
# Hard ceiling on total providers tried per request, including the primary.
FALLBACK_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Logging. Content and instructions are NEVER logged by default; they are only
# sampled when both the flag is true AND LOG_SAMPLE_RATE selects the request.
# ---------------------------------------------------------------------------
LOG_CONTENT=false
LOG_INSTRUCTIONS=false
LOG_SAMPLE_RATE=0

# Interactive Swagger UI. Off by default in production; the machine-readable
# contract at /openapi.json stays available either way.
DOCS_ENABLED=
PUBLIC_BASE_URL=
